<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_light"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <View
                android:id="@+id/headerBar"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@color/maroon_primary"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Claims"
                android:textColor="@color/gold_secondary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toTopOf="@id/headerBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitNewClaim"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="+ Submit a New Claim"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-26dp"
                app:backgroundTint="@color/maroon_primary_dark"
                app:cornerRadius="12dp"
                app:layout_constraintTop_toBottomOf="@id/headerBar" />

            <LinearLayout
                android:id="@+id/llEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp"
                app:layout_constraintTop_toBottomOf="@id/btnSubmitNewClaim">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/img_empty_state" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No claims submitted yet"
                    android:textColor="@color/on_surface_light"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="When you submit a claim, it will appear here."
                    android:textColor="@color/on_surface_variant_light"
                    android:textSize="13sp"
                    android:textAlignment="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llClaimsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/btnSubmitNewClaim" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>