<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_light"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <View
                android:id="@+id/headerBar"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@color/maroon_primary"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Policy"
                android:textColor="@color/gold_secondary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toTopOf="@id/headerBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-40dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/surface_card_light"
                app:layout_constraintTop_toBottomOf="@id/headerBar">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChoosePackage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose Funeral Package"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POLICY INFORMATION"
                        android:textColor="@color/on_surface_variant_light"
                        android:textSize="11sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPolicyNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Policy: —"
                        android:textColor="@color/on_surface_light"
                        android:textSize="14sp"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tvPolicyType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Type: —"
                        android:textColor="@color/on_surface_light"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvPolicyCover"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cover: —"
                        android:textColor="@color/on_surface_light"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvPolicyPremium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Premium: —"
                        android:textColor="@color/on_surface_light"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/tvPolicyStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: —"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_status_pill" />

                    <TextView
                        android:id="@+id/tvWaitingPeriod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Waiting period: 3 months"
                        android:textColor="@color/on_surface_variant_light"
                        android:textSize="12sp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tvPremiumSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Payment summary: Loading..."
                        android:textColor="@color/on_surface_light"
                        android:textSize="13sp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tvPolicyStartDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start date: —"
                        android:textColor="@color/on_surface_variant_light"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvBeneficiariesHeading"
                android:text="Beneficiaries"
                android:textColor="@color/maroon_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardPolicy"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/llBeneficiaries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvBeneficiariesHeading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvPaymentHistoryHeading"
                android:text="Payment History"
                android:textColor="@color/maroon_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/llBeneficiaries"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/llPayments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvPaymentHistoryHeading" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>