<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Header Bar -->
        <View
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/maroon_primary"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy &amp; Security"
            android:textColor="@color/gold_secondary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toTopOf="@id/headerBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Content Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/surface_card_light"
            app:layout_constraintTop_toBottomOf="@id/headerBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Privacy Matters"
                    android:textColor="@color/maroon_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hlungwane Burial is committed to protecting the personal information of our policyholders and their families. We follow the Protection of Personal Information Act (POPIA) of South Africa."
                    android:textColor="@color/on_surface_light"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_gold"
                    android:layout_marginVertical="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data We Collect"
                    android:textColor="@color/maroon_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Your name, email, and contact details\n• Your South African ID number\n• Your policy and claim details\n• Payment and premium information"
                    android:textColor="@color/on_surface_light"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How We Protect It"
                    android:textColor="@color/maroon_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• All data is encrypted in transit\n• Row-Level Security ensures you only see your own information\n• Password authentication is required to access your account\n• We never share your data with third parties without consent"
                    android:textColor="@color/on_surface_light"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Rights"
                    android:textColor="@color/maroon_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Access your data at any time\n• Request corrections to inaccurate information\n• Request deletion of your account\n• Lodge a complaint with the Information Regulator"
                    android:textColor="@color/on_surface_light"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last updated: October 2026"
                    android:textColor="@color/on_surface_variant_light"
                    android:textSize="11sp"
                    android:layout_marginTop="24dp"
                    android:textStyle="italic" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>