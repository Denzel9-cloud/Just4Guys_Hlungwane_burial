<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.just4guys.hlungwaneburial.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.just4guys.hlungwaneburial.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.just4guys.hlungwaneburial.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeFragment_to_myPolicyFragment"
            app:destination="@id/myPolicyFragment" />
        <action
            android:id="@+id/action_homeFragment_to_claimsFragment"
            app:destination="@id/claimsFragment" />
    </fragment>

    <fragment
        android:id="@+id/myPolicyFragment"
        android:name="com.just4guys.hlungwaneburial.ui.policy.MyPolicyFragment"
        android:label="My Policy"
        tools:layout="@layout/fragment_my_policy" />

    <fragment
        android:id="@+id/claimsFragment"
        android:name="com.just4guys.hlungwaneburial.ui.claims.ClaimsFragment"
        android:label="Claims"
        tools:layout="@layout/fragment_claims">
        <action
            android:id="@+id/action_claimsFragment_to_submitClaimFragment"
            app:destination="@id/submitClaimFragment" />
    </fragment>

    <fragment
        android:id="@+id/submitClaimFragment"
        android:name="com.just4guys.hlungwaneburial.ui.claims.SubmitClaimFragment"
        android:label="Submit Claim"
        tools:layout="@layout/fragment_submit_claim" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.just4guys.hlungwaneburial.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.just4guys.hlungwaneburial.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_contactSupportFragment"
            app:destination="@id/contactSupportFragment" />
        <action
            android:id="@+id/action_profileFragment_to_privacyFragment"
            app:destination="@id/privacyFragment" />
    </fragment>

    <!-- NEW: Contact Support Screen -->
    <fragment
        android:id="@+id/contactSupportFragment"
        android:name="com.just4guys.hlungwaneburial.ui.profile.ContactSupportFragment"
        android:label="Contact Support"
        tools:layout="@layout/fragment_contact_support" />

    <!-- NEW: Privacy & Security Screen -->
    <fragment
        android:id="@+id/privacyFragment"
        android:name="com.just4guys.hlungwaneburial.ui.profile.PrivacyFragment"
        android:label="Privacy &amp; Security"
        tools:layout="@layout/fragment_privacy" />

</navigation>