<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.HlungwaneBurial" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (slightly lighter in dark mode for contrast) -->
        <item name="colorPrimary">@color/maroon_primary_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/maroon_primary</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Gold secondary -->
        <item name="colorSecondary">@color/gold_secondary</item>
        <item name="colorOnSecondary">@color/on_surface_dark</item>
        <item name="colorSecondaryContainer">@color/gold_secondary_dark</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Surfaces (dark) -->
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_card_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>

        <!-- Error -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Bars -->
        <item name="android:statusBarColor">@color/maroon_primary_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

</resources>