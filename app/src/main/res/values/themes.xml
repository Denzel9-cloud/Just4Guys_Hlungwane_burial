<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme — Hlungwane Burial brand -->
    <style name="Theme.HlungwaneBurial" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/maroon_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/maroon_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary brand color (gold) -->
        <item name="colorSecondary">@color/gold_secondary</item>
        <item name="colorOnSecondary">@color/on_surface_light</item>
        <item name="colorSecondaryContainer">@color/gold_secondary_light</item>
        <item name="colorOnSecondaryContainer">@color/on_surface_light</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="colorSurface">@color/surface_card_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>

        <!-- Error -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status bar / navigation bar -->
        <item name="android:statusBarColor">@color/maroon_primary_dark</item>
        <item name="android:navigationBarColor">@color/surface_card_light</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Splash screen theme (used before MainActivity loads) -->
    <style name="Theme.HlungwaneBurial.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/maroon_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.HlungwaneBurial</item>
    </style>

</resources>